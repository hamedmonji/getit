{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getit",
  "version": "0.2.0",
  "identifier": "com.hamedmonji.getit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "getit",
        "width": 1040,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRjRBQ0I1MUNDOTdBMEQKUldRTmVza2N0YXowOHRIQnEzZFFsNzg0S0JJQlIxbHJvM3o4MSs2QjVDcWxkMTJVMUZUUEwrOEoK",
      "endpoints": [
        "https://github.com/hamedmonji/getit/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
